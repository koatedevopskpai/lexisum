# =============================================================
# LexiSum environment configuration
# Copy to `.env` and fill in the keys for your chosen provider.
# =============================================================

# ---------- Core pipeline ----------
# Context strategy: auto | single_shot | chunked_recursive
CONTEXT_STRATEGY=auto
# Sentence overlap ratio when chunking (0.0 - 0.5)
CHUNK_OVERLAP_RATIO=0.1
# Safety cap on chunk size (tokens) for small-context models
MAX_CHUNK_TOKENS=6000

# ---------- Abstractive model (LiteLLM model id) ----------
# Examples: gpt-4o-mini, gpt-4o, claude-3-5-haiku, gemini-1.5-flash
# For cloud providers use the LiteLLM prefixed form, e.g.
#   azure/gpt-4o-mini, vertex_ai/gemini-1.5-flash, bedrock/claude-3-5-haiku
ABSTRACTIVE_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
# Max tokens to generate in the final summary call
MAX_OUTPUT_TOKENS=800

# ---------- Extractive engine ----------
# Extractive engine: sbert | textrank
EXTRACTIVE_ENGINE=sbert
# Sentence embedding model for SBERT extractor
SBERT_MODEL=all-MiniLM-L6-v2
# Default number of extractive sentences
EXTRACTIVE_TOP_N=3

# ---------- Provider credentials (fill in as needed) ----------
# OpenAI
OPENAI_API_KEY=

# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_API_VERSION=

# GCP Vertex AI (LiteLLM)
GEMINI_API_KEY=

# AWS Bedrock
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ---------- FinOps / logging ----------
# Tags applied to every cost log record
FINOP_TAGS={"environment":"dev","team":"legal"}
# Path to the usage log (JSON-lines)
USAGE_LOG_PATH=logs/usage.log